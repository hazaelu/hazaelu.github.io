---
// 👇 SECCIÓN SUPERIOR DE JAVASCRIPT REFACTORIZADA PARA TAILWIND V4 (EN) 👇
import { getCollection } from 'astro:content';

// 🟢 CORRECCIÓN: Subimos dos niveles (../../) para encontrar la carpeta components
import Analytics from '../../components/Analytics.astro'; 

// 🟢 CORRECCIÓN: Subimos dos niveles (../../) para encontrar la carpeta styles
import '../../styles/global.css';

const todosLosProyectos = await getCollection('proyectos');
const proyectosIngles = todosLosProyectos.filter(proyecto => proyecto.filePath?.includes('/en/'));
const proyectosOrdenados = proyectosIngles.sort((a, b) => a.data.fase - b.data.fase);

const pageTitle = "Hazael Urriola | Jamstack Ecosystem";

const traductorEstado = {
  "Completado": "Completed",
  "En Progreso": "In Progress",
  "Próximamente": "Upcoming"
};
---

<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<Analytics /> 
	</head>
	
	<!-- Body estilizado homogéneamente -->
	<body class="bg-[#0a0e14] text-[#f0f6fc] font-sans antialiased max-w-[1000px] mx-auto px-5 py-10">
		
		<!-- Header con Flexbox responsivo en Inglés -->
		<header class="flex flex-col sm:flex-row justify-between items-start gap-4 mb-10 pb-5 border-b border-[#30363d]">
			<div class="space-y-2">
				<h1 class="text-4xl font-extrabold tracking-tight bg-gradient-to-r from-[#58a6ff] to-white bg-clip-text text-transparent">
					Development Ecosystem
				</h1>
				<p class="text-[#8b949e] text-lg leading-relaxed">
					Modular portfolio built with Astro Content Layer Architecture and native internationalization.
				</p>
			</div>
			
			<!-- Conmutador de idiomas invertido para la versión en inglés -->
			<div class="flex gap-2 self-start sm:self-auto">
				<a href="/" class="bg-[#151b23] border border-[#30363d] text-[#f0f6fc] px-3 py-1.5 rounded-md text-sm font-semibold hover:border-[#58a6ff]/50 hover:text-[#58a6ff] transition-all">
					ES
				</a>
				<a href="/en" class="bg-blue-500/10 border border-[#58a6ff] text-[#58a6ff] px-3 py-1.5 rounded-md text-sm font-semibold transition-all">
					EN
				</a>
			</div>
		</header>

		<main>
			<!-- Rejilla Bento Grid de Tailwind v4 -->
			<section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
				{proyectosOrdenados.map((proyecto) => (
					<a href={proyecto.data.url} class="group bg-[#151b23] border border-[#30363d] rounded-xl p-6 flex flex-col justify-between hover:border-[#58a6ff] hover:-translate-y-1 transition-all duration-300 shadow-md hover:shadow-xl hover:shadow-blue-500/5">
						<div>
							<div class="flex justify-between items-start mb-4">
								<span class="text-3xl filter drop-shadow-sm group-hover:scale-110 transition-transform duration-300">
									{proyecto.data.icono}
								</span>
								
								<!-- Badges dinámicos mapeados con el diccionario bilingüe -->
								<span class={`text-xs px-2.5 py-1 rounded-full font-semibold border ${
									proyecto.data.estado === 'Completado' ? 'bg-green-500/10 text-[#3fb950] border-green-500/30' :
									proyecto.data.estado === 'En Progreso' ? 'bg-amber-500/10 text-[#d29922] border-amber-500/30' :
									'bg-gray-500/10 text-[#8b949e] border-[#30363d]'
								}`}>
									Phase {proyecto.data.fase} • {traductorEstado[proyecto.data.estado]}
								</span>
							</div>
							
							<h3 class="text-xl font-bold mb-2 group-hover:text-[#58a6ff] transition-colors">
								{proyecto.data.titulo}
							</h3>
							<p class="text-[#8b949e] text-sm leading-relaxed mb-5">
								{proyecto.data.descripcion}
							</p>
						</div>
						
						<!-- Etiquetas de Tecnologías -->
						<div class="flex flex-wrap gap-2 mt-auto">
							{proyecto.data.tecnologias.map((tech) => (
								<span class="bg-[#8b949e]/10 text-[#58a6ff] text-xs px-2 py-0.5 rounded border border-[#58a6ff]/10 font-medium">
									{tech}
								</span>
							))}
						</div>
					</a>
				))}
			</section>
		</main>
	</body>
</html>
