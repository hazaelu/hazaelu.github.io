---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const todosLosDocs = await getCollection('docs');
const docsIngles = todosLosDocs.filter((doc: CollectionEntry<'docs'>) => 
	doc.filePath?.includes('/en/')
);

const docsOrdenados = docsIngles.sort((a, b) => a.data.order - b.data.order);
const documentoActivo = docsOrdenados[0];
const { Content } = documentoActivo ? await render(documentoActivo) : { Content: null };

const pageTitle = "Technical Documentation | Hazael Urriola";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>{pageTitle}</title>
		<style>
			:root {
				--bg-main: #0a0e14;
				--bg-sidebar: #151b23;
				--border-color: #30363d;
				--text-primary: #f0f6fc;
				--text-secondary: #8b949e;
				--accent: #58a6ff;
			}

			body {
				font-family: system-ui, -apple-system, sans-serif;
				background-color: var(--bg-main);
				color: var(--text-primary);
				margin: 0;
				padding: 0;
				display: flex;
				min-height: 100vh;
			}

			.sidebar {
				width: 280px;
				background-color: var(--bg-sidebar);
				border-right: 1px solid var(--border-color);
				padding: 30px 20px;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}

			.sidebar-brand h2 { font-size: 1.1rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-secondary); margin: 0 0 5px 0; }
			.sidebar-brand p { font-size: 0.85rem; color: var(--accent); margin: 0 0 30px 0; font-weight: bold; }

			.back-home { color: var(--text-secondary); text-decoration: none; font-size: 0.9rem; margin-bottom: 25px; display: inline-block; }
			.back-home:hover { color: var(--text-primary); }

			.nav-group-title { font-size: 0.8rem; font-weight: bold; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 10px; }
			.nav-links { list-style: none; padding: 0; margin: 0; }
			.nav-link { display: block; padding: 8px 12px; color: var(--text-primary); text-decoration: none; border-radius: 6px; font-size: 0.95rem; margin-bottom: 5px; }
			.nav-link.active { background-color: rgba(88, 166, 255, 0.1); color: var(--accent); font-weight: 600; border: 1px solid rgba(88, 166, 255, 0.2); }

			.lang-switcher a { color: var(--text-secondary); text-decoration: none; font-size: 0.85rem; font-weight: 600; }
			.lang-switcher a:hover { color: var(--accent); }

			.main-content {
				flex: 1;
				padding: 60px 40px;
				max-width: 800px;
				overflow-y: auto;
			}

			.doc-article :global(h1) { font-size: 2.2rem; font-weight: 800; margin-top: 0; border-bottom: 1px solid var(--border-color); padding-bottom: 15px; }
			.doc-article :global(h2) { font-size: 1.5rem; margin-top: 35px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px; }
			.doc-article :global(p) { line-height: 1.7; color: #e6edf3; font-size: 1.05rem; }
			.doc-article :global(ul) { padding-left: 20px; line-height: 1.7; }
			.doc-article :global(li) { margin-bottom: 8px; }
			.doc-article :global(code) { background-color: rgba(139, 148, 158, 0.15); padding: 3px 6px; border-radius: 6px; font-family: monospace; font-size: 0.9rem; color: #ff7b72; }
			.doc-article :global(pre) { background-color: #161b22; border: 1px solid var(--border-color); padding: 16px; border-radius: 8px; overflow-x: auto; margin: 20px 0; }
			.doc-article :global(pre code) { background-color: transparent; padding: 0; color: inherit; font-size: 0.9rem; }
		</style>
	</head>
	<body>
		<aside class="sidebar">
			<div>
				<a href="/en" class="back-home">← Back to Home</a>
				<div class="sidebar-brand">
					<h2>Ecosystem Core</h2>
					<p>Official Documentation</p>
				</div>
				
				<nav>
					<div class="nav-group-title">Getting Started</div>
					<ul class="nav-links">
						{docsOrdenados.map((doc: CollectionEntry<'docs'>) => (
							<li>
								<a href="/en/docs" class="nav-link active">
									{doc.data.title}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</div>

			<div class="lang-switcher">
				<a href="/docs">🇪🇸 Spanish Version</a>
			</div>
		</aside>

		<main class="main-content">
			<article class="doc-article">
				{Content ? <Content /> : <p>No documents found.</p>}
			</article>
		</main>
	</body>
</html>
