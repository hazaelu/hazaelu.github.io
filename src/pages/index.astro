---
// 👇 SECCIÓN SUPERIOR DE JAVASCRIPT REFACTORIZADA PARA TAILWIND V4 👇
import { getCollection } from 'astro:content';
import Analytics from '../components/Analytics.astro'; 

// 🟢 Inyección obligatoria del mapa de estilos utilitarios de Tailwind v4
import '../styles/global.css';

const todosLosProyectos = await getCollection('proyectos');
const proyectosEspanol = todosLosProyectos.filter(proyecto => proyecto.filePath?.includes('/es/'));
const proyectosOrdenados = proyectosEspanol.sort((a, b) => a.data.fase - b.data.fase);

const pageTitle = "Hazael Urriola | Ecosistema Jamstack";
---

<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<Analytics /> 
	</head>
	
	<!-- Reemplazo de body antiguo por clases utilitarias (Fondo oscuro, tipografía de sistema y ancho max) -->
	<body class="bg-[#0a0e14] text-[#f0f6fc] font-sans antialiased max-w-[1000px] mx-auto px-5 py-10">
		
		<!-- Reemplazo de header antiguo por Flexbox moderno y responsivo -->
		<header class="flex flex-col sm:flex-row justify-between items-start gap-4 mb-10 pb-5 border-b border-[#30363d]">
			<div class="space-y-2">
				<h1 class="text-4xl font-extrabold tracking-tight bg-gradient-to-r from-[#58a6ff] to-white bg-clip-text text-transparent">
					Ecosistema de Desarrollo
				</h1>
				<p class="text-[#8b949e] text-lg leading-relaxed">
					Portafolio modularizado con Arquitectura Astro Content Layer e internacionalización nativa.
				</p>
			</div>
			
			<!-- Conmutador de idiomas estilizado (Reemplazo de .lang-switcher y .lang-link) -->
			<div class="flex gap-2 self-start sm:self-auto">
				<a href="/" class="bg-blue-500/10 border border-[#58a6ff] text-[#58a6ff] px-3 py-1.5 rounded-md text-sm font-semibold transition-all">
					ES
				</a>
				<a href="/en" class="bg-[#151b23] border border-[#30363d] text-[#f0f6fc] px-3 py-1.5 rounded-md text-sm font-semibold hover:border-[#58a6ff]/50 hover:text-[#58a6ff] transition-all">
					EN
				</a>
			</div>
		</header>

		<main>
			<!-- Reemplazo de .bento-grid antigua por una rejilla responsiva auto-ajustable -->
			<section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
				{proyectosOrdenados.map((proyecto) => (
					/* Reemplazo de .card antigua por una tarjeta con efectos de microinteracciones fluidas */
					<a href={proyecto.data.url} class="group bg-[#151b23] border border-[#30363d] rounded-xl p-6 flex flex-col justify-between hover:border-[#58a6ff] hover:-translate-y-1 transition-all duration-300 shadow-md hover:shadow-xl hover:shadow-blue-500/5">
						<div>
							<div class="flex justify-between items-start mb-4">
								<!-- El icono ahora se agranda sutilmente cuando pasas el cursor sobre la tarjeta -->
								<span class="text-3xl filter drop-shadow-sm group-hover:scale-110 transition-transform duration-300">
									{proyecto.data.icono}
								</span>
								
								<!-- Badges dinámicos mapeados con condicionales nativos de Tailwind -->
								<span class={`text-xs px-2.5 py-1 rounded-full font-semibold border ${
									proyecto.data.estado === 'Completado' ? 'bg-green-500/10 text-[#3fb950] border-green-500/30' :
									proyecto.data.estado === 'En Progreso' ? 'bg-amber-500/10 text-[#d29922] border-amber-500/30' :
									'bg-gray-500/10 text-[#8b949e] border-[#30363d]'
								}`}>
									Fase {proyecto.data.fase} • {proyecto.data.estado}
								</span>
							</div>
							
							<h3 class="text-xl font-bold mb-2 group-hover:text-[#58a6ff] transition-colors">
								{proyecto.data.titulo}
							</h3>
							<p class="text-[#8b949e] text-sm leading-relaxed mb-5">
								{proyecto.data.descripcion}
							</p>
						</div>
						
						<!-- Contenedor .tech-stack y etiquetas .tech-tag estilizadas -->
						<div class="flex flex-wrap gap-2 mt-auto">
							{proyecto.data.tecnologias.map((tech) => (
								<span class="bg-[#8b949e]/10 text-[#58a6ff] text-xs px-2 py-0.5 rounded border border-[#58a6ff]/10 font-medium">
									{tech}
								</span>
							))}
						</div>
					</a>
				))}
			</section>
		</main>
	</body>
</html>
